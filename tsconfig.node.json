{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "./dist/node"
  },
  "include": ["prisma/**/*"],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}
